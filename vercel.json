{
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "query", "key": "comercio" }],
      "dest": "/api/dynamic-og"
    },
    {
      "src": "/",
      "has": [{ "type": "query", "key": "oferta" }],
      "dest": "/api/dynamic-og"
    },
    {
      "src": "/",
      "has": [{ "type": "query", "key": "atractivo" }],
      "dest": "/api/dynamic-og"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
